// ---------- BUFFERS (GLOBAL) ----------
float buffer[WINDOW];
int idx = 0;

// ---------- MATH FUNCTIONS ----------
float mean(float *x, int N) {
  float s = 0;
  for(int i=0;i<N;i++) s += x[i];
  return s/N;
}

float stddev(float *x, int N, float m) {
  float s = 0;
  for(int i=0;i<N;i++) s += (x[i]-m)*(x[i]-m);
  return sqrt(s/N);
}

float energy(float *x, int N) {
  float s = 0;
  for(int i=0;i<N;i++) s += x[i]*x[i];
  return s;
}

float distance(float *a, float *b) {
  float s = 0;
  for(int i=0;i<NUM_FEATURES;i++)
    s += (a[i]-b[i])*(a[i]-b[i]);
  return sqrt(s);
}

int predict(float *feat) {
  int best = 0;
  float best_dist = 1e12;

  for(int i=0;i<NUM_TRAIN;i++) {
    float d = distance(feat, X_train[i]);
    if(d < best_dist) {
      best_dist = d;
      best = y_train[i];
    }
  }
  return best;
}
float max_val(float *x, int N) {
  float m = x[0];
  for(int i=1;i<N;i++)
    if(x[i] > m) m = x[i];
  return m;
}

float min_val(float *x, int N) {
  float m = x[0];
  for(int i=1;i<N;i++)
    if(x[i] < m) m = x[i];
  return m;
}



void setup() {
  Serial.begin(115200);
  Wire.begin();

}

void loop() {
  float ax = getAccelX(); 

  buffer[idx++] = ax;

  if(idx == WINDOW) {

    // ---- Feature extraction ----
    float f[5];
    f[0] = mean(buffer, WINDOW);
    f[1] = stddev(buffer, WINDOW, f[0]);
    f[2] = max_val(buffer, WINDOW);
    f[3] = min_val(buffer, WINDOW);
    f[4] = energy(buffer, WINDOW);
    // ---- ML DECISION ----
    int cls = predict(f);
    if(cls==0) Serial.println("STILL");
    if(cls==1) Serial.println("SHAKE");
    if(cls==2) Serial.println("ROTATE");

    idx = 0;
  }
}


